{
  "upstream": {
    "project": "musicdl",
    "repo": "https://github.com/CharlesPikachu/musicdl",
    "license": "PolyForm Noncommercial 1.0.0"
  },
  "notes": "音源目录唯一真源：Node 服务与 Python 搜索内核都读取本文件。新增平台只需在此登记 musicdl 的客户端类名（className）。",
  "defaults": ["migu", "kuwo", "kugou", "qianqian"],
  "groups": [
    { "id": "all", "name": "全部", "short": "全部", "hint": "显示所有已接入平台" },
    { "id": "cn", "name": "国内音乐", "short": "国内", "hint": "网易云 / QQ / 酷狗 / 酷我 / 咪咕 / 汽水 / B站等" },
    { "id": "global", "name": "海外平台", "short": "海外", "hint": "部分需要 FFmpeg / N_m3u8DL-RE 等解密工具" },
    { "id": "audio", "name": "有声读物", "short": "有声", "hint": "喜马拉雅 / 懒人听书 / 荔枝FM / 蜻蜓FM / 播客" },
    { "id": "hub", "name": "聚合网关", "short": "聚合", "hint": "一个站点代理多个上游音源" },
    { "id": "site", "name": "第三方站点", "short": "第三方", "hint": "非官方站点，稳定性与音质参差" }
  ],
  "presets": [
    { "id": "fast", "name": "快速四源", "sources": ["migu", "kuwo", "kugou", "qianqian"] },
    { "id": "cn", "name": "国内主力", "sources": ["migu", "kuwo", "kugou", "qianqian", "netease", "qq", "soda", "bilibili"] },
    { "id": "audio", "name": "有声读物", "sources": ["ximalaya", "lrts", "lizhi", "qingting", "itunes"] },
    { "id": "global", "name": "海外精选", "sources": ["youtube", "soundcloud", "spotify", "tidal", "qobuz", "deezer", "joox", "audius", "jamendo"] },
    { "id": "hub", "name": "聚合网关", "sources": ["gdstudio", "tunehub", "mp3juice", "myfreemp3", "jbsou", "xiaobai"] }
  ],
